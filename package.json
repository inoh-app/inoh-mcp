{
  "name": "inoh-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Inoh MCP server — the vocabulary app for the articulate.",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch --import tsx src/index.ts",
    "dev:prod": "node --env-file-if-exists=.env.prod --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.prod dist/index.js",
    "token:local": "node --env-file-if-exists=.env.local --import tsx scripts/mint-local-token.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:fixture": "deno run --allow-env --allow-net ${INOH_BACKEND_DIR:-../inoh-backend}/supabase/e2e/cli.ts",
    "e2e:doctor": "pnpm e2e:fixture doctor",
    "e2e:test": "vitest run --config e2e/vitest.config.ts",
    "e2e:run": "pnpm e2e:doctor && pnpm e2e:test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.115.0",
    "express": "^5.2.1",
    "jose": "^6.2.11",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
