# Template for the env file of one environment. Copy it to .env.local for
# local Supabase, or to .env.prod for production: `pnpm dev` loads .env.local
# and `pnpm dev:prod` loads .env.prod, one file each, nothing layered. Neither
# is ever committed - both hold live Supabase keys.

# Port the MCP HTTP server listens on
PORT=3333

# Interface to bind. Use 0.0.0.0 when running in a container or behind a proxy.
HOST=127.0.0.1

# Externally reachable base URL of this server. Advertised to MCP clients in
# OAuth metadata. Defaults to http://HOST:PORT.
# PUBLIC_URL=https://mcp.inoh.app

# Base URL of the Inoh web app this server links to. Every card link a tool
# hands an AI client is built from it. Defaults to https://app.inoh.app, which
# is right in production; point it at the local Expo web server (`pnpm web` in
# the inoh repo) when running against local Supabase, or a locally created card
# links to a word page that does not exist on production.
# WEB_APP_URL=http://localhost:8080

# Supabase project URL. Must match the `iss` claim Supabase puts in user JWTs
# exactly (for local Supabase that is http://127.0.0.1:54321, not localhost).
SUPABASE_URL=http://127.0.0.1:54321

# Publishable (anon) key of the same project. Sent as the `apikey` header on
# database requests; the signed-in user's bearer token is forwarded alongside
# it, so Row Level Security still runs as that user.
# Local: `supabase status -o env` -> PUBLISHABLE_KEY. Prod: dashboard -> API Keys.
SUPABASE_PUBLISHABLE_KEY=

# Legacy JWT shared secret of the same project. Required while the project
# signs tokens with HS256 (prod today), and for `pnpm token:local`. Projects on
# asymmetric signing keys are verified via the JWKS and can leave this empty.
# Local: `supabase status -o env` -> JWT_SECRET. Prod: dashboard -> Project
# Settings -> JWT Keys.
SUPABASE_JWT_SECRET=

# Browser origins allowed to call /mcp, comma-separated. Requests with no
# Origin header (Claude Desktop, the CLI, Codex, Cursor — every native client)
# are always allowed; only a request claiming a browser origin has to match.
# Defaults to WEB_APP_URL alone, so an unrecognised web client is refused
# until it is added here deliberately.
# ALLOWED_ORIGINS=https://inoh.app,https://claude.ai
